# === Wallet & Chain ===
# Base mainnet RPC (use a paid provider for production - free RPCs throttle hard)
BASE_RPC_URL=https://mainnet.base.org
# Optional: HTTPS URL of a Base archive node for simulation (Tenderly, Alchemy, etc)
BASE_FORK_RPC_URL=
# Hex private key WITHOUT 0x prefix - holds ~$20 ETH on Base
PRIVATE_KEY=
# Address that will receive any swept funds at deadline (28 May 2026)
DEADLINE_SWEEP_ADDRESS=

# === LLM ===
# Primary: Xiaomi MiMo V2.5 (https://platform.xiaomimimo.com)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_FAST_MODEL=mimo-v2.5-flash
MIMO_PRO_MODEL=mimo-v2.5-pro
# Fallback: Anthropic (kept as escalation for high-stakes calls only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# === Survival / Treasury ===
# Hard deadline (ISO-8601). Agent halts and sweeps funds at this time.
SURVIVAL_DEADLINE=2026-05-28T23:59:59Z
# Floor of ETH (in ETH) below which agent stops trading and goes into cold-watch mode
ETH_FLOOR=0.001
# Max % of treasury to risk on a single trade (e.g. 0.10 = 10%)
MAX_RISK_PER_TRADE=0.10
# Hard cap on Anthropic spend (USD) - protects the $10 budget
ANTHROPIC_BUDGET_USD=10
# Hard cap on MIMO spend (USD-equivalent estimate) - mostly informational since 100T credit ≈ massive
MIMO_BUDGET_USD=100000

# === Strategy gating ===
# Master kill-switch. Must be true for any tx to be sent.
ENABLE_LIVE_TRADING=false
# Per-strategy enables (independent of master switch)
ENABLE_LIQUIDATION_HUNTER=true
ENABLE_POST_EXPLOIT_ARB=true
ENABLE_DISTRESSED_ASSET=false

# === Event sources ===
# Forta API (free tier OK). Leave blank to skip.
FORTA_API_KEY=
# rekt.news RSS poll interval (ms)
REKT_POLL_INTERVAL_MS=300000
# Mempool / block tail interval (ms)
CHAIN_POLL_INTERVAL_MS=12000
# Liquidation queue scan interval (ms)
LIQUIDATION_POLL_INTERVAL_MS=30000

# === Logging / state ===
LOG_LEVEL=info
STATE_DIR=./data
# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
